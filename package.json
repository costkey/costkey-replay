{
  "name": "@costkey/replay",
  "version": "0.1.0",
  "description": "Session replay for browser agents. Records the pages your Playwright or Puppeteer agent drives and lines them up with its LLM calls in CostKey.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/vendor/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/vendor-rrweb.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "costkey",
    "session-replay",
    "rrweb",
    "browser-agent",
    "playwright",
    "puppeteer",
    "cdp",
    "agents",
    "observability"
  ],
  "author": "CostKey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/costkey/costkey-replay"
  },
  "homepage": "https://costkey.dev",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "costkey": ">=0.7.0",
    "playwright-core": ">=1.40.0",
    "puppeteer-core": ">=22.0.0"
  },
  "peerDependenciesMeta": {
    "costkey": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rrweb/record": "2.2.2",
    "@types/node": "^25.5.0",
    "playwright-core": "1.65.0",
    "puppeteer-core": "25.16.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
